
# ---------------------------------------------------------------------------
# Layer real secrets in a gitignored .envrc.local (optional).
# ---------------------------------------------------------------------------
# An `if`, not `[ -f x ] && source_env x`: the latter is the last command in the
# file, so its exit status is the file's, and direnv reports the whole .envrc as
# failed for everyone who has no .envrc.local. Optional means optional.
if [ -f .envrc.local ]; then
	source_env .envrc.local
fi
