{
  "name": "@noetive/mcp-server",
  "version": "0.1.1",
  "description": "Connect your AI editor to the Noetive Semantik semantic broker over MCP",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "noetive",
    "semantik",
    "ai",
    "agent",
    "llm"
  ],
  "homepage": "https://noetive.io/mcp",
  "bugs": {
    "url": "https://github.com/noetive/noetive-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noetive/noetive-mcp.git",
    "directory": "installer"
  },
  "license": "ISC",
  "author": "Noetive.io",
  "mcpName": "io.noetive/mcp-server",
  "type": "commonjs",
  "bin": {
    "noetive-mcp": "./bin/noetive-mcp.js"
  },
  "files": [
    "bin/",
    "dist/src/",
    "postinstall.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "postinstall": "node postinstall.js",
    "prepublishOnly": "node -e \"if(!Object.keys(require('./package.json').optionalDependencies||{}).length)throw new Error('optionalDependencies is empty; scripts/build-platform-packages.js writes them and must run before publish, or this wrapper resolves no binary on any platform')\""
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
